<?xml version="1.0" encoding="utf-8"?>
<!-- A single prayer column: name over time, mirroring the table widget's slot. Added to cw_prayer_row
     via addView; the weight makes columns share the row width evenly. Text + color set at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/cw_col_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/custom_widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/cw_col_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/custom_widget_text"
        android:textSize="13sp" />

</LinearLayout>
