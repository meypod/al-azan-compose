<?xml version="1.0" encoding="utf-8"?>
<!-- A single header slot (date or location name). Added to custom_widget_header via addView; the
     weight makes 1 cell fill the header and 2 cells split it evenly. Text + color set at runtime. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_header_text"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center"
    android:maxLines="1"
    android:textColor="@color/custom_widget_text"
    android:textSize="13sp" />
